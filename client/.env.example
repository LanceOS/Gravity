# Copy to client/.env for local Vite development. Vite reads this directory even
# when npm is run from the repository root. Never commit client/.env.

# Server-only development proxy target. Default: http://localhost:8080.
# Allowed without extra configuration: http://localhost:8080,
# http://127.0.0.1:8080, http://[::1]:8080. Use an HTTP(S) origin only;
# credentials, paths, queries, and fragments are rejected.
# BACKEND_UPSTREAM=http://127.0.0.1:8080
# For a different trusted target, list its exact origin here (comma-separated).
# GRAVITY_DEV_PROXY_ALLOWED_ORIGINS=http://backend:8080

# All VITE_ values are public in the browser build. Never put secrets, tokens,
# passwords, or private backend URLs in them. Unlisted VITE_ names fail Vite
# startup and builds. These reviewed settings are optional:
# VITE_FRONTEND_PUBLIC_URL=https://app.example.com
#   Public frontend URL used only to allow its hostname in the dev server.
#   Prefer server-only GRAVITY_FRONTEND_PUBLIC_URL for this purpose.
# VITE_ALLOWED_HOSTS=app.example.com
#   Comma-separated extra dev server hostnames you control; never use *.
# VITE_TICKET_URL_BASE=https://tickets.example.com
#   Public ticket link base: a same-origin path or HTTPS origin approved below.
# VITE_ALLOWED_TICKET_HOSTS=tickets.example.com
#   Comma-separated HTTPS ticket hostnames (optionally with ports); see
#   docs/client/TICKET_URL_BASE.md for the accepted host patterns.
# VITE_API_PROXY_TARGET is forbidden. Use server-only BACKEND_UPSTREAM instead.
